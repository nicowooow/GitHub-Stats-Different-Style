{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@core/*": [
        "packages/core/*"
      ],
      "@react/*": [
        "packages/react/*"
      ],
      "@svg/*": [
        "packages/svg/*"
      ],
      "@themes/*": [
        "packages/themes/*"
      ]
    }
  }
}